DATABASE_URL=postgresql+asyncpg://sentinel_user:sentinel_password@postgres:5432/sentinelgraph
REDIS_URL=redis://:sentinel_redis_password@redis:6379/0
KAFKA_BROKERS=kafka:9092
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sentinel_password
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
ANTHROPIC_API_KEY=sk-ant-your-key-here
MODEL_ACTIVE_VERSION=xgb-graph-v1
RISK_TIER_THRESHOLDS=0.30,0.60,0.80
RISK_AGGREGATION_WEIGHTS=0.50,0.30,0.20
ENABLE_AI_INVESTIGATOR=true
ENABLE_DETECTION_REPLAY=true
RISK_CASE_COOLDOWN_HOURS=24
LOG_LEVEL=INFO
